// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


// 商品
model Product {
  id           Int    @id @default(autoincrement())
  thumbnailUrl String // サムネイル画像
  name         String
  description  String // 商品の概要説明
  detail       String //詳細情報
  intensity    Int? // 香りの強さ（1〜5）

  // 商品カテゴリー(香水、スキンケア...)
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])

  volumes Volume[] //容量
  reviews Review[] //レビュー投稿
}

// 商品のカテゴリー
model Category {
  id       Int          @id @default(autoincrement())
  name     CategoryName
  products Product[]
}

enum CategoryName {
  fragrances
  skincare
  bathShaving
  giftSets
}

// 容量ごとの商品情報
model Volume {
  id        Int @id @default(autoincrement())
  productId Int

  volume Int // 容量(100ml,100g)
  price  Int

  images  Image[] //商品画像(複数枚に対応)
  product Product @relation(fields: [productId], references: [id])
}

// 容量ごとの商品画像
model Image {
  id       Int    @id @default(autoincrement())
  imageUrl String
  volumeId Int
  volume   Volume @relation(fields: [volumeId], references: [id])
}

// 商品のレビュー投稿
model Review {
  id        Int @id @default(autoincrement())
  productId Int

  rating     Int //評価値(1~5)
  authorName String
  title      String
  content    String
  createdAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])
}
